# ------------------------------------------------------------------
# AZMARO API – copy to API/.env and fill in. NEVER commit real values.
# Validated at startup (src/config/env.ts) – the server refuses to start
# with missing/invalid settings.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# ── Database (MySQL 8+/9) ──────────────────────────────────────────
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Add ?ssl=true to require TLS (recommended in production).
DATABASE_URL="mysql://azmaro_app:CHANGE_ME@127.0.0.1:3306/azmaro"
# …or leave DATABASE_URL out and give the parts separately (DATABASE_URL wins if both are set):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=azmaro_app
# DB_PASSWORD=CHANGE_ME
# DB_NAME=azmaro

# ── Frontend ───────────────────────────────────────────────────────
# Comma-separated origins allowed by CORS + the CSRF origin check (storefront, admin panel)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Public storefront URL used in emails (verify email / reset password links)
APP_URL=http://localhost:3000
# Number of trusted reverse proxies in front of the API (for correct client IPs / rate limits)
TRUST_PROXY=1

# ── Auth ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Must be true in production (HTTPS)
COOKIE_SECURE=false
# Optional, e.g. .azmaro.com when the API is on a subdomain
COOKIE_DOMAIN=
BCRYPT_ROUNDS=12

# ── Integrations ───────────────────────────────────────────────────
# demo = clearly labelled development adapters (test orders, no payment collected,
#        no courier data); live = refuse online payment without a real provider
INTEGRATION_MODE=demo

# Payments – UPI / cards / net banking via Razorpay (COD needs no provider)
PAYMENT_PROVIDER=none            # none | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Courier
SHIPPING_PROVIDER=none           # none | shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PIN=
# Shared secret couriers send in X-Courier-Token on status webhooks
COURIER_WEBHOOK_SECRET=

# Email / CRM delivery (POST JSON). Empty = development outbox (nothing sent).
EMAIL_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=

# Optional initial delivery charges written by the seed (editable later in /admin/settings)
DELIVERY_FLAT_FEE_INR=
DELIVERY_FREE_ABOVE_INR=

# ── Rate limits (per IP per window) ────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_FORMS_MAX=10

# ── Misc ───────────────────────────────────────────────────────────
LEGACY_API_ENABLED=true          # unversioned /api/* used by the current web app
API_DOCS_ENABLED=true            # Swagger UI at /api/docs
WEB_PUBLIC_DIR=../web/public     # product images are downloaded here

# First admin account (created by `npm run db:seed` only when both are set; ≥ 12 chars)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
