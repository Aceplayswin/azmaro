# Storefront (web/) production settings – copied to web/.env.production on every deploy.
# Public values only (NEXT_PUBLIC_* are baked into the browser bundle). Secrets go in the API_ENV secret.

# The API on the same server (Server Components call it directly).
API_URL=http://127.0.0.1:4000

# Canonical links, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=https://azmaro.dollara.tech

# Contact details shown on the Contact page / footer. Empty = hidden.
# WhatsApp in international format, digits only, e.g. 91XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_INSTAGRAM_URL=
