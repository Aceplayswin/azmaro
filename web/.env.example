# ------------------------------------------------------------------
# AZMARO web (Next.js) – copy to web/.env.local
# Only public display settings + the backend URL live here.
# Secrets and integration credentials belong in API/.env.
# ------------------------------------------------------------------

# Where the AZMARO API runs. Server Components call it directly, and
# browser requests to /api/* are proxied to it (see next.config.ts).
API_URL=http://localhost:4000

# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact details (Contact page, footer, mobile menu). Empty = hidden.
# WhatsApp number in international format, digits only, e.g. 91XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_INSTAGRAM_URL=
